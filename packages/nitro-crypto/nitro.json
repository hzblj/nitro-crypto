{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitrocrypto"
  ],
  "ios": {
    "iosModuleName": "NitroCrypto"
  },
  "android": {
    "androidNamespace": [
      "nitrocrypto"
    ],
    "androidCxxLibName": "NitroCrypto"
  },
  "autolinking": {
    "NitroCrypto": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridNitroCrypto"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "build"
  ]
}
