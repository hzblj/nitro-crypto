{
  "name": "@hzblj/crypto-airgap",
  "version": "0.0.0",
  "description": "Air-gapped signing as data: Uniform Resources (BC-UR v2) with Bytewords, deterministic CBOR and fountain-coded multipart transport, a typed registry, and the public account types (crypto-hdkey, crypto-keypath, crypto-multi-accounts). Pure TypeScript with no dependencies: no UI, no camera, no native code; SHA-256 comes from the caller (the nitro-crypto engine).",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/nitro-crypto.git",
    "directory": "packages/crypto-airgap"
  },
  "bugs": {
    "url": "https://github.com/hzblj/nitro-crypto/issues"
  },
  "homepage": "https://github.com/hzblj/nitro-crypto/tree/main/packages/crypto-airgap#readme",
  "keywords": [
    "air-gap",
    "airgap",
    "bc-ur",
    "bytewords",
    "cbor",
    "fountain-codes",
    "hardware-wallet",
    "keystone",
    "qr",
    "react-native",
    "uniform-resources",
    "wallet"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p ./tsconfig.build.json",
    "clean": "rm -rf build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "tsc -p ./tsconfig.json",
    "test": "node --conditions=source --import tsx --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@hzblj/nitro-crypto": "workspace:*",
    "@keystonehq/bc-ur-registry": "0.8.1",
    "@ngraveio/bc-ur": "1.1.13",
    "@scure/bip32": "2.4.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
