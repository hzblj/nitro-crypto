{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `source` resolves the workspace packages to their TypeScript, so a type check needs no build (the base config
    // explains why the example app cannot do the same).
    "customConditions": ["source", "react-native"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
