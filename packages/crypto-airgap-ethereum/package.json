{
  "name": "@hzblj/crypto-airgap-ethereum",
  "version": "0.1.0",
  "description": "Ethereum air-gapped signing for @hzblj/crypto-airgap: ERC-4527 eth-sign-request and eth-signature for EIP-1559 transactions and personal messages, every answer checked by recovering its signer with @hzblj/crypto-ethereum. No UI, no camera.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/nitro-crypto.git",
    "directory": "packages/crypto-airgap-ethereum"
  },
  "bugs": {
    "url": "https://github.com/hzblj/nitro-crypto/issues"
  },
  "homepage": "https://github.com/hzblj/nitro-crypto/tree/main/packages/crypto-airgap-ethereum#readme",
  "keywords": [
    "air-gap",
    "bc-ur",
    "eip-1559",
    "erc-4527",
    "eth-sign-request",
    "eth-signature",
    "ethereum",
    "hardware-wallet",
    "keystone",
    "qr",
    "react-native",
    "wallet"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p ./tsconfig.build.json",
    "clean": "rm -rf build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "tsc -p ./tsconfig.json",
    "test": "node --conditions=source --import tsx --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@hzblj/crypto-airgap": "workspace:^",
    "@hzblj/crypto-ethereum": "workspace:^"
  },
  "peerDependencies": {
    "@hzblj/nitro-crypto": "workspace:^"
  },
  "devDependencies": {
    "@hzblj/nitro-crypto": "workspace:*",
    "@keystonehq/bc-ur-registry-eth": "0.22.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "viem": "2.57.11"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
