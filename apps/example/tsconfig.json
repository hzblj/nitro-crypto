{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This repository's packages' TypeScript source, as Metro runs it (metro.config.js maps their `source` exports), so
    // the example type-checks against them without a build. The air-gap packages come from npm.
    "paths": {
      "@hzblj/crypto-bitcoin": ["../../packages/crypto-bitcoin/src/index.ts"],
      "@hzblj/crypto-bitcoin/sync": ["../../packages/crypto-bitcoin/src/sync/index.ts"],
      "@hzblj/crypto-ethereum": ["../../packages/crypto-ethereum/src/index.ts"],
      "@hzblj/crypto-solana": ["../../packages/crypto-solana/src/index.ts"],
      "@hzblj/nitro-crypto": ["../../packages/nitro-crypto/src/index.ts"],
      "@hzblj/nitro-crypto/adapter": ["../../packages/nitro-crypto/src/adapter.ts"],
      "@hzblj/nitro-crypto/testing": ["../../packages/nitro-crypto/src/testing.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "native-icons.d.ts"],
  "exclude": ["test"]
}
