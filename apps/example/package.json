{
  "name": "nitro-crypto-example",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "expo:prebuild": "expo prebuild --clean",
    "clean:native": "rm -rf android ios .expo",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "tsc -p ./tsconfig.json && tsc -p ./test/tsconfig.json",
    "test": "node --conditions=source --import tsx --test 'test/**/*.test.ts'",
    "e2e": "node ./e2e/run.mjs"
  },
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "@hzblj/crypto-airgap": "workspace:*",
    "@hzblj/crypto-airgap-bitcoin": "workspace:*",
    "@hzblj/crypto-airgap-ethereum": "workspace:*",
    "@hzblj/crypto-airgap-solana": "workspace:*",
    "@hzblj/crypto-bitcoin": "workspace:*",
    "@hzblj/crypto-ethereum": "workspace:*",
    "@hzblj/crypto-solana": "workspace:*",
    "@hzblj/kara-ui": "^0.15.3",
    "@hzblj/nitro-crypto": "workspace:*",
    "@legendapp/list": "3.6.0",
    "@lodev09/react-native-true-sheet": "3.11.18",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "auto-zustand-selectors-hook": "3.0.1",
    "expo": "~57.0.31",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "immer": "11.1.21",
    "qrcode-generator": "2.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.14",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
