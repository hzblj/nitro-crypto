# Dependencies
node_modules/

# Yarn (node-modules linker: only the release/plugins are committed)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Turborepo
.turbo

# Package build output
packages/*/build/
packages/*/android/build/
packages/*/android/.cxx/
packages/*/android/.gradle/
*.tgz

# The engine: Zig's caches and fetched packages, and the prebuilt artifacts `yarn engine` writes into the package
packages/zig-engine-crypto/.zig-cache/
packages/zig-engine-crypto/zig-out/
packages/zig-engine-crypto/zig-pkg/
packages/nitro-crypto/engine/
packages/nitro-crypto/src/host/wasm-binary.generated.ts

# Expo
.expo/
expo-env.d.ts
web-build/
dist/

# Native projects of the example app are generated by prebuild
apps/example/ios/
apps/example/android/

# Native secrets
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*

# Metro
.metro-health-check*

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript
*.tsbuildinfo

# Editors and agents
.claude/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# System
.DS_Store
Thumbs.db

# Env
.env*
!.env.example

# pack-check scratch
.pack-check/
