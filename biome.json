{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "@hzblj/biome-config",
    "@hzblj/biome-config/react-native"
  ],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.expo",
      "!**/.turbo",
      "!**/.pack-check",
      "!**/build",
      "!**/nitrogen/generated",
      "!**/*.generated.ts",
      "!**/engine",
      "!packages/zig-engine-crypto/.zig-cache",
      "!packages/zig-engine-crypto/zig-out",
      "!packages/zig-engine-crypto/zig-pkg",
      "!packages/zig-engine-crypto/test/vectors",
      "!apps/example/ios",
      "!apps/example/android",
      "!**/expo-env.d.ts"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/babel.config.js",
        "**/metro.config.js",
        "**/react-native.config.js"
      ],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
